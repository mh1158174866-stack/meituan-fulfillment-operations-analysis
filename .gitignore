.DS_Store
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# 美团官方数据禁止重新分发：原始、明细级中间数据一律不入 Git。
data/raw/**
!data/raw/.gitkeep
data/interim/**
!data/interim/.gitkeep
data/processed/**
!data/processed/.gitkeep

# 仅允许人工复核后的聚合结果进入公开仓库。
outputs/tables/*.csv
outputs/tables/*.json
outputs/tables/*.parquet

# 本地数据库、缓存和下载日志。
*.duckdb
*.duckdb.wal
logs/*.log
references/*.pdf
